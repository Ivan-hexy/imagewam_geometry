# Optional: copy to .env.local and edit paths. No credentials belong here.
# Defaults work when dataset and checkpoints are under the repository root.
# Dataset defaults to data/simple_rgbd_1aa44615/ (789 episodes).
# Override ROOT and CACHE together; never combine different dataset revisions.
# export SIMPLE_RGBD_ROOT=/path/to/SIMPLE-RGBD-Teleop
# export SIMPLE_RGBD_CACHE=/path/to/SIMPLE-RGBD-Teleop-cache
# export FLUX2_MODEL_PATH=/path/to/flux-2-klein-base-4b.safetensors
# export FLUX2_AE_MODEL_PATH=/path/to/ae.safetensors
# export SIMPLE_ACTION_INIT=/path/to/action_dit_init.pt
# export DEPTH_PRO_CHECKPOINT=/path/to/depth_pro.pt
# Optional W&B destination/mode (account login is separate; never add API keys).
# export WANDB_ENTITY=your-authorized-team
# export WANDB_MODE=online
